# argo-cd 차트 10.9.6 (ArgoCD v3.5.3) values. 지금은 변수 보간이 없지만(repo_url 은
# root Application 전용 별도 릴리스 — charts/root-app/ — 로 옮겼다, 아래 주석 참고),
# brief 가 지정한 파일명(.tftpl)과 templatefile() 호출 방식을 그대로 유지해 Task 6 이후
# values 에 변수가 필요해져도 바로 확장할 수 있게 둔다.
#
# 🔴 실측(2026-10-04, helm show values argo/argo-cd --version 10.9.6): hostname 은
# 단수 문자열이다. 구버전 예제의 hosts: [...] 배열 형태를 쓰면 Helm 이 조용히 버리고
# Ingress 가 global.domain 기본값(argocd.example.com)으로 엉뚱하게 뜬다.
configs:
  params:
    # TLS 종료는 Ingress(ingress-nginx)가 한다 — ArgoCD 서버 자체는 평문 HTTP 로 띄운다.
    server.insecure: true
server:
  ingress:
    enabled: true
    ingressClassName: nginx
    hostname: argocd.localtest.me
    path: /
    pathType: Prefix
    tls: false

# 🔴 root Application 을 여기(extraObjects)에 두지 않는다 — brief·설계 스펙(D5)의 원안이
# 이것이었으나, 2026-10-04 이 환경에서 실측한 결과 **이 chart 를 단일 helm install 로
# "CRD 와 그 CRD 를 쓰는 CR(extraObjects 의 Application)을 함께" 설치하면 100% 재현되는
# 실패**를 만났다:
#
#   $ helm install argo-cd argo/argo-cd --version 10.9.6 -n argocd --create-namespace \
#       -f <extraObjects 포함 values>
#   Error: unable to build kubernetes objects from release manifest: resource mapping
#   not found for name: "root" namespace: "argocd" from "": no matches for kind
#   "Application" in version "argoproj.io/v1alpha1"
#   ensure CRDs are installed first
#
# 원인: 이 chart 는 CRD 를 Helm 의 특수 crds/ 디렉터리가 아니라 평범한 templates/ 파일로
# 담고 있다(실측: `helm pull --untar` 후 crds/ 디렉터리 자체가 없음, CRD 가
# templates/crds/*.yaml 에 있고 .Values.crds.install 로 토글됨). Helm 클라이언트는 전체
# 매니페스트를 "적용 순서로 정렬"하기 **전에** 매니페스트 전체를 한 번에 Kubernetes 오브젝트
# 목록으로 빌드하면서 RESTMapper 로 GVK 를 해석하는데, 이 시점엔 아직 CRD 가 클러스터에
# 없다 — CRD 가 매니페스트 순서상 Application 보다 먼저 적용될 예정이어도, 빌드 단계
# 자체가 실패해 **네임스페이스조차 생성되지 않고** 전체 install 이 즉시 실패한다(재시도해도
# 같은 결과 — 실측: 동일 명령 2회 연속 같은 에러, 부분 생성 흔적 없음). 즉 "같은 릴리스가
# CRD 와 함께 적용되니 순서 문제가 사라진다"는 D5 의 원래 근거는 **Terraform plan 시점의
# CRD 문제(kubernetes_manifest)에는 맞지만, Helm apply 시점의 CRD-CR 동시 설치 문제에는
# 틀렸다** — 둘은 다른 레이어의 문제다.
#
# ⇒ root Application 은 이 값(이 helm_release) 과 분리된 두 번째 helm_release
# (argocd.tf 의 helm_release.root_app, 로컬 chart charts/root-app/)로 설치한다.
# depends_on + wait = true 로 "argo-cd 릴리스가 완전히 끝난 뒤"에만 그 release 가
# apply 되게 해, Application CRD 가 이미 클러스터에 존재하는 상태에서 Application 오브젝트를
# 만든다. kubernetes_manifest 는 여전히 쓰지 않는다(D5 의 핵심 — plan 시점 CRD 스키마
# 조회 문제는 그대로 피한다) — 대신 "Helm 릴리스 2개 + depends_on" 으로 apply 시점 순서를
# 보장한다.
