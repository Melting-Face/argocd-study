# terraform/cluster/kind 의 output 4개 + repo_url + http_host_port 실제 값.
# *.tfvars 는 .gitignore 대상이므로 이 .example 파일을 커밋한다.
# 사용법: cp local.auto.tfvars.example local.auto.tfvars 후 terraform apply.
#
# 🔑 substrate 계약(spec §3-2): 아래 4개는 terraform/cluster/kind 의 outputs 와
# "이름·값"이 정확히 같아야 한다 — terraform_remote_state 를 쓰지 않기로 한 대가다
# (wiki/terraform-stack-boundaries.md). cluster 스택의 output 을 바꾸면 이 파일도 같이 고친다.
kubeconfig_path = "/Users/jin/.kube/argocd-study.config"
kube_context    = "kind-argocd-study"
ingress_profile = "kind"
storage_class   = "standard"

# Task 6(ArgoCD root Application)이 추적할 저장소. HTTPS 고정(변수 validation 참고).
repo_url = "https://github.com/Melting-Face/argocd-study.git"

# 🔑 terraform/cluster/kind 의 같은 이름 변수(extra_port_mappings 의 실제 호스트 포트)와
# 값이 일치해야 한다. cluster 스택 기본값 8081 과 나란히 둔다.
http_host_port = 8081
