{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy*)",
      "Bash(terraform state rm *)",
      "Bash(terraform * state rm*)",
      "Bash(terraform state mv *)",
      "Bash(terraform * state mv*)",
      "Bash(terraform state push *)",
      "Bash(terraform * state push*)",
      "Bash(kind delete cluster *)",
      "Bash(helm uninstall *)",
      "Bash(helmfile destroy *)",
      "Bash(argocd app delete *)",
      "Bash(argocd * app delete*)",
      "Bash(kubectl delete *)",
      "Bash(kubectl * delete*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh repo edit*)",
      "Bash(gh release create*)"
    ],
    "deny": [
      "Bash(*curl*-X POST*)",
      "Bash(*curl*-X PUT*)",
      "Bash(*curl*-X PATCH*)",
      "Bash(*curl*-X DELETE*)",
      "Bash(*curl*--data*)",
      "Bash(*curl*-d *)",
      "Bash(*wget*--post-data*)",
      "Bash(*wget*--post-file*)"
    ]
  },
  "hooks": {}
}
